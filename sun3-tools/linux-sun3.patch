diff --git a/arch/m68k/include/asm/elf.h b/arch/m68k/include/asm/elf.h
index 2def06a99b08..2742bb325326 100644
--- a/arch/m68k/include/asm/elf.h
+++ b/arch/m68k/include/asm/elf.h
@@ -81,7 +81,14 @@ typedef struct user_m68kfp_struct elf_fpregset_t;
 #ifndef CONFIG_SUN3
 #define ELF_ET_DYN_BASE         0xD0000000UL
 #else
-#define ELF_ET_DYN_BASE         0x0D800000UL
+/*
+ * The Sun-3 kernel lives at 0x0E000000, so all of user space is only
+ * ~224MB.  A dyn-base up near the top (the old 0x0D800000) left no room
+ * for a PIE executable, its interpreter, the stack and the brk without
+ * colliding ("elf segment ... requested but the memory is mapped
+ * already").  Put it around 1/4 of the user address space instead.
+ */
+#define ELF_ET_DYN_BASE         0x04000000UL
 #endif
 
