diff --git a/drivers/tty/hvc/hvc_sun3.c b/drivers/tty/hvc/hvc_sun3.c
new file mode 100644
index 000000000000..f68c79922c84
--- /dev/null
+++ b/drivers/tty/hvc/hvc_sun3.c
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Sun-3 PROM console for hvc_console.
+ *
+ * The Sun-3 boot PROM stays resident and mapped (romvec at
+ * LINUX_OPPROM_BEGVM) after the kernel takes over, so its polled
+ * character I/O routines can be used as a simple, interrupt-free
+ * console and interactive tty.  Modelled on hvc_udbg.c.
+ */
+
+#include <linux/console.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/types.h>
+
+#include <asm/oplib.h>
+#include <asm/setup.h>
+
+#include "hvc_console.h"
+
+static struct hvc_struct *hvc_sun3_dev;
+
+static ssize_t hvc_sun3_put(uint32_t vtermno, const u8 *buf, size_t count)
+{
+	size_t i;
+
+	for (i = 0; i < count; i++) {
+		if (buf[i] == '\n')
+			prom_putchar('\r');
+		prom_putchar(buf[i]);
+	}
+
+	return i;
+}
+
+static ssize_t hvc_sun3_get(uint32_t vtermno, u8 *buf, size_t count)
+{
+	size_t i;
+	int c;
+
+	for (i = 0; i < count; i++) {
+		c = prom_nbgetchar();
+		if (c == -1)
+			break;
+		buf[i] = c;
+	}
+
+	return i;
+}
+
+static const struct hv_ops hvc_sun3_ops = {
+	.get_chars = hvc_sun3_get,
+	.put_chars = hvc_sun3_put,
+};
+
+static int __init hvc_sun3_init(void)
+{
+	struct hvc_struct *hp;
+
+	if (!MACH_IS_SUN3)
+		return -ENODEV;
+
+	hp = hvc_alloc(0, 0, &hvc_sun3_ops, 16);
+	if (IS_ERR(hp))
+		return PTR_ERR(hp);
+
+	hvc_sun3_dev = hp;
+
+	return 0;
+}
+device_initcall(hvc_sun3_init);
+
+static int __init hvc_sun3_console_init(void)
+{
+	if (!MACH_IS_SUN3)
+		return -ENODEV;
+
+	hvc_instantiate(0, 0, &hvc_sun3_ops);
+	add_preferred_console("hvc", 0, NULL);
+
+	return 0;
+}
+console_initcall(hvc_sun3_console_init);
