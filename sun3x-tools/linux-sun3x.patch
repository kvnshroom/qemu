# Linux-side hvc_sun3 shim: interactive hvc0 console over the sun3x boot PROM.
# Retired for sun3x in favour of the native zs console (zs-console.patch);
# kept for reference / the real SUN3.  Covers drivers/tty/hvc/{Kconfig,Makefile}
# and the hvc_sun3.c driver (binds for SUN3X too, routing char I/O through
# sun3x_putchar/sun3x_mayget when MACH_IS_SUN3X).
#
diff --git a/drivers/tty/hvc/Kconfig b/drivers/tty/hvc/Kconfig
index 5866195de26a..afc1400d8bf3 100644
--- a/drivers/tty/hvc/Kconfig
+++ b/drivers/tty/hvc/Kconfig
@@ -106,6 +106,16 @@ config HVC_DCC_SERIALIZE_SMP
 	  CPU hotplug to work. For example, during early chipset bringups without
 	  debug serial console support. If unsure, say N.
 
+config HVC_SUN3
+	bool "Sun-3/3x PROM console support"
+	depends on SUN3 || SUN3X
+	select HVC_DRIVER
+	default y
+	help
+	  This enables a polled console and interactive tty (/dev/hvc0)
+	  built on the resident Sun-3 boot PROM's character I/O routines.
+	  It is the standard serial console for the Sun-3 under QEMU.
+
 config HVC_RISCV_SBI
 	bool "RISC-V SBI console support"
 	depends on RISCV_SBI && NONPORTABLE
diff --git a/drivers/tty/hvc/Makefile b/drivers/tty/hvc/Makefile
index 98880e357941..81bdce831561 100644
--- a/drivers/tty/hvc/Makefile
+++ b/drivers/tty/hvc/Makefile
@@ -9,5 +9,6 @@ obj-$(CONFIG_HVC_IRQ)		+= hvc_irq.o
 obj-$(CONFIG_HVC_XEN)		+= hvc_xen.o
 obj-$(CONFIG_HVC_IUCV)		+= hvc_iucv.o
 obj-$(CONFIG_HVC_UDBG)		+= hvc_udbg.o
+obj-$(CONFIG_HVC_SUN3)		+= hvc_sun3.o
 obj-$(CONFIG_HVC_RISCV_SBI)	+= hvc_riscv_sbi.o
 obj-$(CONFIG_HVCS)		+= hvcs.o
diff --git a/drivers/tty/hvc/hvc_sun3.c b/drivers/tty/hvc/hvc_sun3.c
new file mode 100644
index 000000000000..554a5d8f97e6
--- /dev/null
+++ b/drivers/tty/hvc/hvc_sun3.c
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Sun-3 PROM console for hvc_console.
+ *
+ * The Sun-3 boot PROM stays resident and mapped (romvec at
+ * LINUX_OPPROM_BEGVM) after the kernel takes over, so its polled
+ * character I/O routines can be used as a simple, interrupt-free
+ * console and interactive tty.  Modelled on hvc_udbg.c.
+ */
+
+#include <linux/console.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/types.h>
+
+#include <asm/oplib.h>
+#include <asm/setup.h>
+#ifdef CONFIG_SUN3X
+#include <asm/sun3xprom.h>
+#endif
+
+#include "hvc_console.h"
+
+static struct hvc_struct *hvc_sun3_dev;
+
+/*
+ * The sun3 and sun3x boot PROMs offer polled character I/O but through
+ * different entry points: sun3 via the sparc-style romvec wrappers
+ * (prom_putchar/prom_nbgetchar, built only for CONFIG_SUN3) and sun3x via
+ * the sun3x_putchar/sun3x_mayget function pointers set up by
+ * sun3x_prom_init().  Route to whichever the running machine provides.
+ */
+static inline void hvc_sun3_putchar(int c)
+{
+#ifdef CONFIG_SUN3X
+	if (MACH_IS_SUN3X) {
+		sun3x_putchar(c);
+		return;
+	}
+#endif
+#ifdef CONFIG_SUN3
+	prom_putchar(c);
+#endif
+}
+
+static inline int hvc_sun3_nbgetchar(void)
+{
+#ifdef CONFIG_SUN3X
+	if (MACH_IS_SUN3X)
+		return sun3x_mayget();
+#endif
+#ifdef CONFIG_SUN3
+	return prom_nbgetchar();
+#else
+	return -1;
+#endif
+}
+
+static ssize_t hvc_sun3_put(uint32_t vtermno, const u8 *buf, size_t count)
+{
+	size_t i;
+
+	for (i = 0; i < count; i++) {
+		if (buf[i] == '\n')
+			hvc_sun3_putchar('\r');
+		hvc_sun3_putchar(buf[i]);
+	}
+
+	return i;
+}
+
+static ssize_t hvc_sun3_get(uint32_t vtermno, u8 *buf, size_t count)
+{
+	size_t i;
+	int c;
+
+	for (i = 0; i < count; i++) {
+		c = hvc_sun3_nbgetchar();
+		if (c == -1)
+			break;
+		buf[i] = c;
+	}
+
+	return i;
+}
+
+static const struct hv_ops hvc_sun3_ops = {
+	.get_chars = hvc_sun3_get,
+	.put_chars = hvc_sun3_put,
+};
+
+static int __init hvc_sun3_init(void)
+{
+	struct hvc_struct *hp;
+
+	if (!MACH_IS_SUN3 && !MACH_IS_SUN3X)
+		return -ENODEV;
+
+	hp = hvc_alloc(0, 0, &hvc_sun3_ops, 16);
+	if (IS_ERR(hp))
+		return PTR_ERR(hp);
+
+	hvc_sun3_dev = hp;
+
+	return 0;
+}
+device_initcall(hvc_sun3_init);
+
+static int __init hvc_sun3_console_init(void)
+{
+	if (!MACH_IS_SUN3 && !MACH_IS_SUN3X)
+		return -ENODEV;
+
+	hvc_instantiate(0, 0, &hvc_sun3_ops);
+	add_preferred_console("hvc", 0, NULL);
+
+	return 0;
+}
+console_initcall(hvc_sun3_console_init);
